{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "DATABASE_PATH": {
      "description": "SQLite database path",
      "default": "./data/mindwork.db"
    },
    "NODE_ENV": {
      "description": "Node environment",
      "default": "production"
    }
  },
  "regions": ["iad1"],
  "functions": {
    "server.ts": {
      "maxDuration": 60,
      "memory": 3008
    }
  }
}
